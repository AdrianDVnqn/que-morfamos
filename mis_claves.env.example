# Copiá este archivo a mis_claves.env para correr local
# NO subas mis_claves.env al repo (contiene secretos)

DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# deepseek | openai (gpt-4o-mini + gpt-4o) | openai-mini (todo gpt-4o-mini, ~17x más barato) | gemini | hybrid
AI_PROVIDER=deepseek

# Override de modelos para comparar proveedores contra el golden dataset (opcional).
# OPENAI_MINI_MODEL=gpt-4o-mini
# OPENAI_SMART_MODEL=gpt-4o
# GEMINI_MODEL=gemini-2.5-flash-lite
# DEEPSEEK_MODEL=deepseek-chat

# PostgreSQL (Fly.io)
DATABASE_URL=postgres://postgres:PASSWORD@que-morfamos-db.flycast:5432
COLLECTION_NAME=reviews_embeddings

# Redis y otros
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=
DISCORD_WEBHOOK_URL=
THEIPAPI_KEY=

# LangSmith (eval del golden dataset)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=que-morfamos
